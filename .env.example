# Copy to .env for local use. Never commit the filled-in file.

# Shared secret: the MCP endpoint becomes https://<host>/<token>/mcp
ROOTLINE_MCP_TOKEN=

# Read the private working dataset (queue + per-provider exports). Read access
# is enough unless you want rootline_merge_results(write=true).
HF_TOKEN=

# Start runs on GitHub Actions: a fine-grained token limited to Flotrpy/RootLine
# with "Actions: Read and write" (nothing else).
ROOTLINE_GITHUB_TOKEN=

# On your own computer instead of Hugging Face / GitHub:
# ROOTLINE_DATA_DIR=/path/to/RootLine/data
# ROOTLINE_REPO_DIR=/path/to/RootLine

# Try it with made-up data:
# ROOTLINE_MCP_MOCK=1
